                },
                "to": [
                  {
                    "key_code": "a",
                    "modifiers": ["option"]
                  }
                ],
                "type": "basic"
              },
              {
                "from": {
                  "key_code": "open_bracket",
                  "modifiers": { "mandatory": ["option", "shift"] }
                },
                "to": [
                  {
                    "key_code": "a",
                    "modifiers": ["option", "shift"]
                  }
                ],
                "type": "basic"
              }
            ]
          }
        ]
